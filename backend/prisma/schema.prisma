// Schéma MVP iGaz. Montants en FCFA (entiers, pas de décimales).

// Moteur « library » (par défaut) : Vercel sait l'embarquer dans ses fonctions, ce qui n'est pas le cas du fichier
// WebAssembly du mode engineType = "client". rhel-openssl-3.0.x : la cible Linux des fonctions Vercel.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  SUPPLIER
  ADMIN
}

enum SupplierStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SaleKind {
  PURCHASE // achat sans retour de bouteille vide
  EXCHANGE // échange d'une bouteille vide de même marque et même capacité
}

enum OrderStatus {
  PENDING_PAYMENT // mobile money en attente de confirmation officielle
  SUBMITTED // transmise au fournisseur
  ACCEPTED // acceptée, stock décompté
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED // code de confirmation vérifié
  REJECTED // refusée par le fournisseur
  CANCELLED
}

enum StockReason {
  SUPPLIER_UPDATE
  ORDER_ACCEPTED
  ORDER_RELEASED
  ADMIN_CORRECTION
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  role      Role     @default(CLIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  supplier  Supplier?
  addresses Address[]
  orders    Order[]
  checkouts Checkout[]
  reviews   Review[]
  auditLogs AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

/// Notification affichée dans l'application (cloche) et, si l'utilisateur l'a activé, envoyée sur son téléphone (push).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  kind      String // ORDER_NEW, ORDER_ACCEPTED, ORDER_REJECTED, ORDER_READY, ORDER_OUT, ORDER_COMPLETED, ORDER_CANCELLED
  title     String
  body      String
  url       String? // page de l'application à ouvrir
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Abonnement aux notifications push d'un navigateur ou de l'application installée (Web Push, clés VAPID).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model ServiceZone {
  id       String  @id @default(uuid())
  name     String  @unique // commune, ex. « Cocody »
  city     String  @default("Abidjan")
  isActive Boolean @default(true)

  addresses Address[]
  areas     StoreServiceArea[]
  orders    Order[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  zoneId    String
  label     String   @default("Domicile")
  details   String // quartier, repère, indications pour le livreur
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone ServiceZone @relation(fields: [zoneId], references: [id])

  @@index([userId])
}

model Supplier {
  id           String         @id @default(uuid())
  userId       String         @unique
  businessName String
  status       SupplierStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  user      User               @relation(fields: [userId], references: [id])
  documents SupplierDocument[]
  stores    Store[]
}

model SupplierDocument {
  id         String   @id @default(uuid())
  supplierId String
  type       String // autorisation de distribution, pièce d'identité du gérant, etc.
  url        String
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Store {
  id              String   @id @default(uuid())
  supplierId      String
  name            String
  address         String
  phone           String
  opensAt         String   @default("07:00") // HH:mm
  closesAt        String   @default("20:00") // HH:mm
  isOpen          Boolean  @default(true) // suspension temporaire par le fournisseur
  offersDelivery  Boolean  @default(true)
  offersPickup    Boolean  @default(true)
  deliveryFee     Int      @default(0)
  createdAt       DateTime @default(now())

  supplier Supplier           @relation(fields: [supplierId], references: [id])
  areas    StoreServiceArea[]
  products    Product[]
  orders      Order[]
  settlements Settlement[]
  reviews     Review[]
  // Avis visibles (non masqués) : nombre et somme des notes, tenus à jour avec chaque avis (moyenne sans recalcul)
  ratingCount Int @default(0)
  ratingSum   Int @default(0)
}

model StoreServiceArea {
  storeId String
  zoneId  String

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone  ServiceZone @relation(fields: [zoneId], references: [id])

  @@id([storeId, zoneId])
}

model GasBrand {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  products Product[]
}

model CylinderType {
  id         String  @id @default(uuid())
  label      String  @unique // B3, B6, B12...
  capacityKg Int     @unique
  isActive   Boolean @default(true)

  products Product[]
}

model Product {
  id             String   @id @default(uuid())
  storeId        String
  brandId        String
  cylinderTypeId String
  purchasePrice  Int // bouteille pleine sans retour
  exchangePrice  Int // bouteille pleine contre une vide compatible
  isActive       Boolean  @default(true)
  photoUpdatedAt DateTime? // date de la photo envoyée par le dépôt (null : pas de photo) ; sert de version dans l'adresse
  createdAt      DateTime @default(now())

  store        Store        @relation(fields: [storeId], references: [id])
  photo        ProductPhoto?
  brand        GasBrand     @relation(fields: [brandId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])
  inventory    Inventory?
  movements    StockMovement[]
  orderItems   OrderItem[]

  @@unique([storeId, brandId, cylinderTypeId])
}

/// Photo d'un produit, envoyée par le dépôt (déjà réduite par l'application : quelques dizaines de Ko). Gardée en base,
/// à part du produit pour que les listes ne la chargent pas ; servie par GET /products/:id/photo.
model ProductPhoto {
  productId String   @id
  mime      String // image/jpeg, image/png ou image/webp
  data      Bytes
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  productId String   @id
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id        String      @id @default(uuid())
  productId String
  delta     Int
  reason    StockReason
  orderId   String?
  actorId   String?
  note      String?
  createdAt DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

model Order {
  id               String          @id @default(uuid())
  code             String          @unique // référence courte lisible
  clientId         String
  storeId          String
  fulfillment      FulfillmentType
  paymentMethod    PaymentMethod
  status           OrderStatus
  zoneId           String?
  deliveryDetails  String? // copie de l'adresse au moment de la commande
  subtotal         Int
  deliveryFee      Int             @default(0)
  serviceFee       Int             @default(0) // frais de service iGaz payés par le client, figés à la création
  platformShare    Int             @default(0) // part d'iGaz sur les frais de livraison (payée par le dépôt), figée
  total            Int // subtotal + deliveryFee + serviceFee
  confirmationCode String // code à 6 chiffres communiqué au client uniquement
  checkoutId       String? // panier multi-dépôts dont fait partie la commande (null : commande directe)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client   User         @relation(fields: [clientId], references: [id])
  store    Store        @relation(fields: [storeId], references: [id])
  zone     ServiceZone? @relation(fields: [zoneId], references: [id])
  checkout Checkout?    @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  events   OrderEvent[]
  review   Review?
  payments Payment[]

  @@index([clientId, createdAt])
  @@index([storeId, status])
  @@index([checkoutId])
}

/// Passage en caisse d'un panier multi-dépôts : une commande par dépôt (cloisonnement intact), créées ensemble
/// (tout ou rien) et, en mobile money, payées en une seule fois par un Payment rattaché au Checkout.
model Checkout {
  id            String        @id @default(uuid())
  code          String        @unique // référence courte lisible (PN-XXXXXXXX)
  clientId      String
  paymentMethod PaymentMethod
  total         Int // somme des totaux des commandes à la création
  createdAt     DateTime      @default(now())

  client   User      @relation(fields: [clientId], references: [id])
  orders   Order[]
  payments Payment[]

  @@index([clientId, createdAt])
}

/// Avis d'un client sur le dépôt d'une de ses commandes terminées : un seul par commande (pas d'avis sans achat).
/// Masqué par l'admin (abus) : n'est plus affiché et ne compte plus dans la moyenne du dépôt.
model Review {
  id        String    @id @default(uuid())
  orderId   String    @unique
  storeId   String
  clientId  String
  rating    Int // 1 à 5
  comment   String?
  reply     String? // réponse publique du dépôt, une seule fois
  repliedAt DateTime?
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order  Order @relation(fields: [orderId], references: [id])
  store  Store @relation(fields: [storeId], references: [id])
  client User  @relation(fields: [clientId], references: [id])

  @@index([storeId, createdAt])
}

model OrderItem {
  id                     String   @id @default(uuid())
  orderId                String
  productId              String
  kind                   SaleKind
  quantity               Int
  unitPrice              Int // prix figé au moment de la commande
  returnedBrandId        String? // marque de la bouteille vide remise (échange)
  returnedCylinderTypeId String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  actorId   String?
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Rattaché soit à une commande (commande directe, espèces), soit à un Checkout (mobile money d'un panier) :
/// exactement l'un des deux, garanti par la contrainte « Payment_one_target » de la migration 0002.
model Payment {
  id             String        @id @default(uuid())
  orderId        String?
  checkoutId     String?
  method         PaymentMethod
  amount         Int
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique
  providerRef    String?       @unique
  checkoutUrl    String? // page de paiement de l'agrégateur (Paystack), réutilisée si le client réessaie
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  checkout Checkout? @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([checkoutId])
}

/// Réglages de rémunération d'iGaz (une seule ligne, id = 1), modifiés par l'admin (journal d'audit). Ils ne
/// s'appliquent qu'aux nouvelles commandes : chaque commande garde les montants du jour de sa création.
model PlatformSettings {
  id            Int      @id @default(1)
  serviceFee    Int      @default(0) // frais de service par commande, payés par le client
  deliveryShare Int      @default(0) // part d'iGaz sur les frais de livraison d'une commande livrée (plafonnée à ceux-ci)
  updatedAt     DateTime @updatedAt
}

/// Règlement du relevé mensuel d'un dépôt (commandes terminées du mois) : enregistré par l'admin une fois l'argent
/// échangé (Wave, virement…). amount > 0 : le dépôt a payé iGaz ; < 0 : iGaz a payé le dépôt.
model Settlement {
  id           String   @id @default(uuid())
  storeId      String
  month        String // AAAA-MM
  amount       Int
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, month])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}

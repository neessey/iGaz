# Base de données PostgreSQL
DATABASE_URL="postgresql://igaz:igaz@localhost:5432/igaz"

# Authentification
JWT_SECRET="changez-moi-avec-une-longue-valeur-aleatoire"
JWT_EXPIRES_IN="7d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Paiement : secret partagé pour vérifier la signature des webhooks de l'agrégateur
PAYMENT_WEBHOOK_SECRET="changez-moi"

# Seed administrateur (utilisé par `npm run seed`)
ADMIN_PHONE="+2250700000000"

PORT=3000

# Paiement à la livraison : plafond en FCFA (à définir avec le métier)
COD_MAX_AMOUNT=100000

# Démonstration : renvoie le code OTP dans la réponse de l'API (ignoré en production)
EXPOSE_DEV_OTP=false

# Origines autorisées pour l'interface web (séparées par des virgules). Obligatoire en production.
CORS_ORIGIN=http://localhost:3001

# Notifications push (Web Push) : générer une paire avec `npx web-push generate-vapid-keys`. Sans clés, le push est désactivé
# (les notifications restent visibles dans l'application).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@exemple.ci"

# Prestataire SMS. Vide : le message s'affiche dans les journaux (développement ; en production, seulement avec la clé
# de démo). « orange » : API SMS d'Orange Developer (offre SMS Côte d'Ivoire) ; identifiants dans « My apps » du
# portail, forfaits SMS achetés sur le même portail. Ne jamais versionner de vrais identifiants.
SMS_PROVIDER=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Adresse d'envoi Orange (tel:+2250000 pour la Côte d'Ivoire) et nom affiché, s'il est approuvé par Orange (11 car.).
ORANGE_SMS_SENDER=tel:+2250000
ORANGE_SMS_SENDER_NAME=

# SMS au dépôt pour chaque nouvelle commande, en plus de la notification (payant chez le prestataire SMS).
NOTIFY_SUPPLIER_BY_SMS=false
